.container {
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 36rpx;
}

.section-title {
  color: #7a7a84;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.input {
  height: 76rpx;
  padding: 0 24rpx;
  background: #1e1e24;
  border-radius: 12rpx;
  color: #e8e8ea;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.flex {
  flex: 1;
  margin-bottom: 0;
  margin-right: 16rpx;
}

.textarea {
  width: 100%;
  height: 220rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #1e1e24;
  border-radius: 12rpx;
  color: #e8e8ea;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.button {
  background: #3a3a68;
  color: #fff;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.button.small {
  padding: 0 28rpx;
  height: 76rpx;
  line-height: 76rpx;
}

.button.disabled {
  opacity: 0.4;
}

.search-row {
  display: flex;
  align-items: center;
}

.meta {
  color: #6b6b73;
  font-size: 22rpx;
  margin: 12rpx 0 16rpx;
}

.hit {
  background: #1a1a1f;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.hit-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.hit-title {
  font-size: 26rpx;
  color: #cfcfd6;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #2a2a33;
  color: #8a8a92;
}

.tag.both {
  background: #26402f;
  color: #7fc79a;
}

.tag.keyword {
  background: #3a3320;
  color: #d3b46a;
}

.tag.vector {
  background: #26303f;
  color: #7fa8c9;
}

.hit-text,
.note-text {
  font-size: 26rpx;
  color: #a8a8b2;
  line-height: 1.5;
}

.note {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #232329;
  display: flex;
  flex-direction: column;
}

.note-title {
  font-size: 28rpx;
  color: #d8d8de;
  margin-bottom: 6rpx;
}
