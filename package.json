{
  "name": "companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI companion cognitive substrate: PostgreSQL memory + Fastify SSE + pg-boss lifecycle",
  "engines": {
    "node": ">=20.20.2"
  },
  "scripts": {
    "dev": "tsx watch apps/backend/src/server.ts",
    "dev:mock": "tsx watch scripts/dev-with-mock.ts",
    "build": "tsc -p apps/backend/tsconfig.json",
    "start": "node apps/backend/dist/server.js",
    "typecheck": "tsc -p apps/backend/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:seed": "tsx apps/backend/src/db/seed.ts",
    "pg:setup": "tsx scripts/pg.ts setup",
    "pg:start": "tsx scripts/pg.ts start",
    "pg:stop": "tsx scripts/pg.ts stop",
    "pg:status": "tsx scripts/pg.ts status",
    "pg:psql": "tsx scripts/pg.ts psql",
    "pg:wasm": "tsx scripts/pglite-server.ts",
    "check:indexes": "tsx scripts/check-indexes.ts",
    "check:dedupe": "tsx scripts/check-dedupe.ts",
    "check:cooldown": "tsx scripts/check-cooldown.ts",
    "check:insights": "tsx scripts/check-insights.ts",
    "check:evidence": "tsx scripts/check-evidence.ts",
    "load:sse": "tsx scripts/load-sse.ts",
    "db:bootstrap": "pnpm pg:setup && pnpm db:migrate && pnpm db:seed",
    "mock:llm": "tsx scripts/mock-openai-server.ts",
    "smoke:llm": "tsx scripts/smoke-llm.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "corpus:distractors": "tsx scripts/gen-distractors.ts",
    "backfill:embeddings": "tsx scripts/backfill-embeddings.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "selftest": "tsx scripts/selftest.ts",
    "lint": "eslint apps/backend/src"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@electric-sql/pglite-socket": "0.2.13",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
