# --- 基础 ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=

# --- 数据库（docker compose 起的 PG17 + pgvector）---
DATABASE_URL=postgres://companion:companion_dev@127.0.0.1:5432/companion
PG_POOL_MAX=10

# --- 鉴权 ---
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-32-bytes-random-aaaaaaaaaaaaaaaa
JWT_TTL=7d

# --- LLM ---
# 没有 Key 时可以跑本地 mock：先 `pnpm mock:llm`，再 `pnpm dev:mock`
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=60000

# --- Embedding（本地 Ollama + bge-m3 / 任意 OpenAI 兼容服务）---
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH=16

# --- 微信小程序 ---
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_TEMPLATE_PROACTIVE=
# 用于 push 正文里的链接；自用没有网页端就留空，避免推出去一个死链
PUBLIC_BASE_URL=

# --- 主动触达直推（自用强烈建议配，否则只能靠订阅消息额度）---
# off | bark | serverchan | wecom | telegram | generic
PUSH_KIND=off
# bark:       https://api.day.app/你的KEY
# serverchan: https://sctapi.ftqq.com/SCTxxxx.send
# wecom:      https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx（群机器人）
# telegram:   https://api.telegram.org/bot<token>/sendMessage
# generic:    你自己的 webhook，会 POST {title, body, link}
PUSH_URL=
# 只有 telegram 需要（chat_id）
PUSH_TARGET=

# --- 队列 ---
JOB_CONCURRENCY=4
HEARTBEAT_INTERVAL_MINUTES=30
# false = 只跑 HTTP 层，队列降级为 no-op（WASM 验收 / 只读调试用）
JOBS_ENABLED=true

# --- 视觉（可选，永远可关闭）---
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=false
COMFYUI_TIMEOUT_MS=60000
STORAGE_DIR=./var/storage
